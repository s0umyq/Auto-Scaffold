# Auto-Scaffold CLI API Keys
# Copy this file to .env and fill in your keys
# Get keys from:
#   NVIDIA Build: https://build.nvidia.com/
#   Google AI Studio: https://aistudio.google.com/
#   OpenRouter: https://openrouter.ai/

# NVIDIA Build (core tier - primary)
NVIDIA_API_KEY=

# Google AI Studio / Gemini Flash (planning tier - primary)
GEMINI_API_KEY=

# OpenRouter (fallback for both tiers)
OPENROUTER_API_KEY=

# Optional: Multiple keys for round-robin rotation (comma-separated)
# NVIDIA_API_KEYS=key1,key2,key3
# GEMINI_API_KEYS=key1,key2,key3
# OPENROUTER_API_KEYS=key1,key2,key3